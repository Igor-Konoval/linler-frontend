{
  "name": "linler-frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Igor Konoval",
  "scripts": {
    "build": "next build",
    "check": "pnpm run fmt && pnpm run guard",
    "check:ci": "pnpm run fmt:verify && pnpm run lint && pnpm run types",
    "dev": "next dev --disable-source-maps",
    "dev:debug": "next dev",
    "dev:webpack": "next dev --webpack --disable-source-maps",
    "fmt": "prettier --write --ignore-path .prettierignore --ignore-path .gitignore .",
    "fmt:verify": "prettier --check --ignore-path .prettierignore --ignore-path .gitignore .",
    "guard": "pnpm run lint && pnpm run types",
    "lint": "eslint --max-warnings 0 --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "pnpm run lint -- --fix",
    "prepare": "pnpm exec husky install",
    "start": "next start",
    "types": "tsc --noEmit"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@t3-oss/env-nextjs": "^0.11.1",
    "@tanstack/react-query": "^5.59.11",
    "@tanstack/react-query-devtools": "^5.59.11",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-highlight": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-list": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/extension-text-align": "^3.29.2",
    "@tiptap/extension-text-style": "^3.29.2",
    "@tiptap/extension-underline": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookies-next": "^4.3.0",
    "jiti": "^2.3.3",
    "jose": "^5.9.4",
    "lucide-react": "^0.418.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^4.11.2",
    "shadcn": "^4.11.0",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tanstack/eslint-plugin-query": "^5.51.15",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "husky": "^9.1.6",
    "postcss": "^8.4.47",
    "prettier": "^3.0.0",
    "prettier-plugin-packagejson": "^2.0.0",
    "prettier-plugin-tailwindcss": "^0.5.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": "24.x"
  }
}
