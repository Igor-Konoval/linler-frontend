{
  "name": "linler-frontend",
  "version": "0.1.0",
  "private": true,
  "author": "Igor Konoval",
  "scripts": {
    "apply-prettier": "prettier --write --ignore-path .prettierignore --ignore-path .gitignore .",
    "build": "next build",
    "check": "pnpm run validate-eslint && pnpm run verify-prettier && pnpm run typecheck",
    "dev": "next dev",
    "fix-lint": "next lint --fix",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "prepare": "pnpm exec husky install",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate-eslint": "eslint --ext .js,.jsx,.ts,.tsx .",
    "verify-prettier": "prettier --check --ignore-path .prettierignore --ignore-path .gitignore ."
  },
  "dependencies": {
