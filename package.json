    "@tanstack/react-query": "^5.59.11",
    "@tanstack/react-query-devtools": "^5.59.11",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cookies-next": "^4.3.0",
    "jiti": "^2.3.3",
    "jose": "^5.9.4",
    "lucide-react": "^0.418.0",
    "next": "16.2.9",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.5.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.53.0",
    "react-resizable-panels": "^4.11.2",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
